# Get your key at https://gonkarouter.io/dashboard  (new accounts get USD 20 credit)
GONKA_API_KEY=sk-replace-me

# Verify these three with `npm run ping` before trusting them.
# The models page and the docs examples spell these differently, so confirm which one answers.
GONKA_MODEL_CLASSIFIER=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_MODEL_VERIFIER=MiniMaxAI/MiniMax-M2.7
# Kimi is served too slowly by this router for a live path (median 26.5s); unused.
# GONKA_MODEL_KIMI=moonshotai/Kimi-K2.6

# HMAC key for the attestation commitment. Any long random string; `openssl rand -hex 32`.
SHOU_COMMITMENT_KEY=replace-me-with-a-long-random-secret

PORT=8787
