# SHOU — environment template. Names only, no values. Copy to .env and fill in.
# .env is gitignored and must stay that way.

# ─────────────────────────────────────────────────────────────────────────
# SECRETS — never paste these into Slack, a PR, or a shared doc.
# ─────────────────────────────────────────────────────────────────────────

# Gonka Router credential. Each developer should get their OWN key from Jack
# rather than sharing one — a shared key cannot be revoked for one person,
# and you cannot tell whose requests are whose when debugging.
GONKA_API_KEY=

# A Sui private key (suiprivkey1...). OPTIONAL and usually unnecessary: if
# unset, the scripts use your local Sui CLI keystore instead, which is the
# normal setup. NEVER share this, and never commit it. It signs transactions
# that move real balances.
SHOU_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# PUBLIC BY DESIGN — safe to share with the team.
# ─────────────────────────────────────────────────────────────────────────

# Visible in the OAuth redirect URL; not a secret. But whoever runs the
# sign-in page must have their own origin registered in the Enoki portal,
# alongside this client id — registering only one of the two fails with a
# bare `invalid_client_id`.
GOOGLE_CLIENT_ID=

# Enoki's *public* key, documented for use in client-side apps. The Enoki
# PRIVATE key is deliberately not read anywhere in this repo — it authorises
# spending the sponsorship budget and belongs server-side only.
NEXT_PUBLIC_ENOKI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# ON-CHAIN OBJECT IDS — not secrets. These change on every republish, so
# re-read them from shou/demo-ids.json (written by seed-demo.ts) rather than
# trusting a copy someone pasted you yesterday.
# ─────────────────────────────────────────────────────────────────────────

SHOU_PACKAGE_ID=
SHOU_DENY_LIST=
SHOU_POLICY_ID=
SHOU_COIN_TYPE=

# The address that must approve HIGH-tier transfers. To test the guardian
# dashboard you must be the guardian, so reseed with your own address:
#   SHOU_GUARDIAN_ADDRESS=0x… node --experimental-strip-types \
#     packages/driver/src/seed-demo.ts
SHOU_GUARDIAN_ADDRESS=

# Owned by whoever published the package. Passing the id to someone else does
# not grant them anything — the transaction fails unless they hold the object.
# Only needed for registering enclaves and creating deny lists.
SHOU_ADMIN_CAP=
SHOU_ENCLAVE_CONFIG=

# ─────────────────────────────────────────────────────────────────────────
# LOCAL CONFIG — sensible defaults exist for all of these.
# ─────────────────────────────────────────────────────────────────────────

# Enclave listens on 3100 (3000 belongs to the sign-in server, whose OAuth
# origin is registered against that port).
PORT=
ENCLAVE_URL=

# Score with the built-in keyword heuristic instead of Gonka. The 404 is fixed,
# so this is now only for running without a key. It labels itself on screen as
# not a real classifier, so nothing claims to be a model verdict when it isn't.
SHOU_TEST_SCORER=

# Suppress server auto-start so a test can call startServer() itself.
SHOU_NO_AUTOSTART=

# Both have working defaults in enclave/src/server.ts; set only to override.
#   GONKA_ROUTER_URL=https://api.gonkarouter.io/v1/chat/completions
#   GONKA_MODELS=<classifier>,<verifier>
# Short model ids ("kimi", "minimax") return HTTP 400 invalid_model.
GONKA_ROUTER_URL=
GONKA_MODELS=

# Comma-separated browser origins allowed to call the circuit breaker.
# Defaults to localhost:3000 and 127.0.0.1:3000. Add yours if you serve the
# dashboard from a different port (Vite defaults to 5173).
SHOU_ALLOWED_ORIGINS=

# Demo knobs, all optional.
SHOU_COOLDOWN_MS=
SHOU_AMOUNT=
SHOU_RECIPIENT=
SHOU_SCAMMER_RECIPIENT=
